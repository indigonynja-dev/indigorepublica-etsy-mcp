# systemd --user unit for remote (Claude.ai) mode.
# Install:  mkdir -p ~/.config/systemd/user && cp deploy/nynja-etsy-mcp.service ~/.config/systemd/user/
#           systemctl --user daemon-reload && systemctl --user enable --now nynja-etsy-mcp
#           loginctl enable-linger $USER   # keep it running when you're logged out
[Unit]
Description=Nynja Etsy MCP (HTTP mode for Claude.ai)
After=network-online.target

[Service]
WorkingDirectory=%h/mcp-servers/nynja-etsy-mcp
ExecStart=%h/.local/bin/uv run nynja-etsy-mcp --transport http
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
