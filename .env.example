# ---- Etsy app credentials (etsy.com/developers/your-apps -> "See API Key Details")
ETSY_KEYSTRING=your_keystring_here
ETSY_SHARED_SECRET=your_shared_secret_here

# Must match a Callback URL registered on your Etsy app EXACTLY.
ETSY_REDIRECT_URI=http://localhost:3003/oauth/redirect

# Space-separated OAuth scopes requested during `indigorepublica-etsy-auth`.
ETSY_SCOPES=listings_r listings_w listings_d shops_r shops_w transactions_r transactions_w profile_r feedback_r billing_r

# Optional: pin the shop. Auto-detected from the token if blank.
ETSY_SHOP_ID=

# Where OAuth tokens live (chmod 600). Shared by stdio and HTTP modes.
ETSY_TOKEN_FILE=~/.indigorepublica-etsy-mcp/tokens.json

# ---- Safety
# readonly = GET only | safe = writes OK, deletes blocked (default) | full = everything
ETSY_MCP_MODE=safe
# Folders the server may read files from when uploading images/digital files (colon-separated).
ETSY_UPLOAD_DIRS=~/etsy-products
# Requests per second to Etsy (pending/personal apps are limited; stay low).
ETSY_MAX_QPS=4

# ---- Remote (Claude.ai) mode only
MCP_HTTP_HOST=127.0.0.1
MCP_HTTP_PORT=8765
# Long random string. Claude.ai sends it as "Authorization: Bearer <token>". Generate: openssl rand -hex 32
MCP_AUTH_TOKEN=
# Public hostname(s) of your tunnel, comma-separated, e.g. mybox.tail1234.ts.net
MCP_PUBLIC_HOSTS=
